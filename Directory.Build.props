<Project>

  <!-- Build conventions of the InfinitySuite360 organisation. -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Publisher information (GitHub organisation InfinitySuite360). The version is set from the git tag in CI. -->
  <PropertyGroup>
    <Version>0.3.0</Version>
    <Authors>InfinitySuite360</Authors>
    <Company>InfinitySuite360</Company>
    <Product>Cloudflare InfinitySuite360</Product>
    <Copyright>Copyright © 2026 InfinitySuite360</Copyright>
    <RepositoryUrl>https://github.com/InfinitySuite360/infinitysuite360_cloudflare</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/InfinitySuite360/infinitysuite360_cloudflare</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/InfinitySuite360/infinitysuite360_cloudflare/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>cloudflare;cloudflare-api;openapi;kiota;dns;waf;turnstile;zero-trust;tunnel;r2;workers;infinitysuite360</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- No licence chosen yet: set PackageLicenseExpression (for example MIT) before publishing outside the organisation. -->
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
