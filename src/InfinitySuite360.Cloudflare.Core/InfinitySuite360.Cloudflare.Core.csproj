<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The core without the generated OpenAPI client: curated clients, raw API access, Access JWT, Turnstile, write guard, retries, dependency injection.
    Depends only on Microsoft.Extensions.*. Services that only need Access JWT or DNS reference this package instead of InfinitySuite360.Cloudflare.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>InfinitySuite360.Cloudflare</RootNamespace>
    <PackageId>InfinitySuite360.Cloudflare.Core</PackageId>
    <Title>Cloudflare InfinitySuite360 – Core</Title>
    <Description>Slim .NET client for the Cloudflare API v4 without the generated OpenAPI client: curated clients for zones, DNS, rulesets/WAF, Turnstile, Tunnel, Zero Trust Access, Email Routing, R2, Workers, monitoring, security, certificates and GraphQL Analytics, raw access to any endpoint, and validation of Cloudflare Access tokens. Depends only on Microsoft.Extensions.*. Writes are disabled by default, retries honour Retry-After, the token never appears in errors. InfinitySuite360.Cloudflare adds the complete generated client. Community package, not affiliated with Cloudflare, Inc.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfinitySuite360.Cloudflare" />
    <InternalsVisibleTo Include="InfinitySuite360.Cloudflare.Tests" />
  </ItemGroup>

</Project>
