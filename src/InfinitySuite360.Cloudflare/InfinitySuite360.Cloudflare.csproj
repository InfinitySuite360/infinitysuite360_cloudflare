<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>InfinitySuite360.Cloudflare</RootNamespace>
    <PackageId>InfinitySuite360.Cloudflare</PackageId>
    <Title>Cloudflare InfinitySuite360</Title>
    <Description>.NET client for the Cloudflare API v4. Includes the complete generated client for every operation of Cloudflare's official OpenAPI schema (InfinitySuite360.Cloudflare.OpenApi) plus curated clients for zones, DNS, rulesets/WAF, Turnstile, Tunnel, Zero Trust Access, Email Routing, R2, Workers, monitoring, security, certificates and GraphQL Analytics. Writes are disabled by default, retries honour Retry-After, the token never appears in errors. Community package, not affiliated with Cloudflare, Inc.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfinitySuite360.Cloudflare.OpenApi\InfinitySuite360.Cloudflare.OpenApi.csproj" />
    <InternalsVisibleTo Include="InfinitySuite360.Cloudflare.Tests" />
  </ItemGroup>

</Project>
